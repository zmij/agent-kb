# Qdrant connection
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true

# Embedding backend: fastembed | ollama
KB_EMBED_BACKEND=fastembed

# fastembed model (used when KB_EMBED_BACKEND=fastembed)
KB_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Ollama (used when KB_EMBED_BACKEND=ollama)
KB_OLLAMA_URL=http://localhost:11434
KB_OLLAMA_MODEL=nomic-embed-text

# Consuming repository root — where kb.yaml lives and corpus paths resolve
# from. Auto-detected by walking up from the CWD when unset; the kb-register
# make target bakes it into the MCP registration explicitly.
KB_REPO_ROOT=

# Project config path override (default: <KB_REPO_ROOT>/kb.yaml)
KB_CONFIG=
